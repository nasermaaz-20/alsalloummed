{
  "name": "alsalloum-medical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir tmp/ssr-build --emptyOutDir && node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "format": "prettier --write src vite.config.ts index.html scripts package.json tsconfig.json"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
