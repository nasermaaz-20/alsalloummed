      "css": ".ds-case{border:1px solid var(--border,#dce4eb);border-radius:14px;overflow:hidden;min-width:0;background:#fff;color:var(--text-primary,#182c46);font-family:\"Alexandria\",\"Segoe UI\",Arial,sans-serif;}.ds-case-body{padding:22px}.ds-case h3{margin:0;font-size:1.15rem;font-weight:600;line-height:1.5}.ds-case p{margin:12px 0 0;font-size:.9rem;line-height:1.85;color:var(--text-secondary,#4b6078)}.ds-case .ds-case-type{font-size:.8rem;color:var(--brand-blue,#025d9c);margin-top:8px;margin-bottom:0}.ds-link{display:inline-flex;align-items:center;gap:12px;min-height:48px;color:var(--brand-blue,#025d9c);font-weight:500;font-size:.94rem;background:none;border:0;padding:0;text-align:start;margin-top:12px;cursor:pointer;font-family:\"Alexandria\",\"Segoe UI\",Arial,sans-serif;}.ds-link:hover{text-decoration:underline;text-underline-offset:5px}.ds-button:focus-visible,.ds-link:focus-visible,.ds-filter:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-row:focus-visible{outline:3px solid var(--brand-blue,#025d9c);outline-offset:4px;}"
    },
    {
      "name": "Specialty Row",
      "kind": "custom",
      "refersTo": "specialty-row",
      "description": "صف مفتوح بفواصل وسهم دائري؛ المعاينة تستخدم ترتيب الموبايل.",
      "html": "<a class=\"ds-row\" dir=\"rtl\" href=\"#specialty\"><h3>مستلزمات العمود الفقري</h3><span class=\"ds-arrow\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7M5 12h14\"/></svg></span><p>التخصص والمادة المتاحة من المصادر.</p></a>",
      "css": ".ds-row{display:grid;grid-template-columns:1fr 48px;gap:16px;padding-block:24px;border-block:1px solid var(--border,#dce4eb);align-items:start;color:var(--text-primary,#182c46);text-decoration:none;font-family:\"Alexandria\",\"Segoe UI\",Arial,sans-serif;}.ds-row h3{margin:0;font-size:1.12rem;font-weight:600;line-height:1.5}.ds-row p{grid-column:1/-1;margin:0;font-size:.9rem;max-width:680px;line-height:1.85;color:var(--text-secondary,#4b6078)}.ds-arrow{display:inline-flex;width:48px;height:48px;border:1px solid #b9c9d8;border-radius:50%;align-items:center;justify-content:center;color:var(--brand-blue,#025d9c);transition:background-color .18s,color .18s}.ds-row:hover .ds-arrow{background:var(--brand-blue,#025d9c);color:#fff;border-color:var(--brand-blue,#025d9c)}.ds-button:focus-visible,.ds-link:focus-visible,.ds-filter:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-row:focus-visible{outline:3px solid var(--brand-blue,#025d9c);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-button,.ds-link,.ds-filter,.ds-row .ds-arrow{transition-duration:.01ms!important;}}"
